# ============================================
# Invitia - Variables d'environnement
# ============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=votre_url_supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_supabase

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://eventiafinally.vercel.app

# WhatsApp de l'admin, indicatif pays sans espaces. La page Offres l'utilise
# si le numéro n'est pas encore enregistré dans le profil.
# NEXT_PUBLIC_ADMIN_WHATSAPP=

# Après avoir créé le projet Supabase, exécutez dans le SQL Editor :
# supabase/schema.sql puis supabase/migrations/005_handle_new_user.sql
# puis supabase/migrations/006_hosted_invitation.sql
# puis supabase/migrations/007_hosted_guests.sql

# Clé secrète pour promouvoir un utilisateur en super_admin
# Générer avec: openssl rand -hex 32
# Utilisation: curl -X POST https://invitia.vercel.app/api/admin/seed \
#   -H "Content-Type: application/json" \
#   -d '{"email":"admin@exemple.com","secret":"VOTRE_CLE_ICI"}'
ADMIN_SEED_KEY=changez_moi_par_une_cle_securisee
# Pixel Meta (Facebook) : identifiant numérique du pixel. Sans lui, aucun suivi n'est chargé.
# NEXT_PUBLIC_FB_PIXEL_ID=
